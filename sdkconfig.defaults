# Settings shared by every target. Per-chip overrides live in
# sdkconfig.defaults.<target>, which ESP-IDF layers on top of this file.
#
# sdkconfig itself is generated and gitignored. Edit this file, then
# `idf.py reconfigure` -- editing sdkconfig directly is lost on the next
# set-target.

# --- Partition table -------------------------------------------------------
# A/B OTA with a LittleFS partition named "res". Point this at partitions/8mb_ota.csv
# or 16mb_ota.csv for a larger part; the flash size below has to agree.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/4mb_ota.csv"

# --- OTA rollback ----------------------------------------------------------
# Firmware that boots and never calls ota_mark_valid() is rolled back on the next
# reset. This is what makes an A/B layout worth having: a bad update undoes
# itself instead of needing a cable.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Console ---------------------------------------------------------------
# The web console carries command output over a WebSocket, which
# esp_http_server compiles out unless this is set.
CONFIG_HTTPD_WS_SUPPORT=y
# Every command group in app_console.c is one slot. The default of 32 was exactly
# full: adding a group made app_console_register() fail with ESP_ERR_NO_MEM and
# the device abort at boot. The table holds pointers only.
CONFIG_CLI_MAX_GROUPS=48

# --- Networking ------------------------------------------------------------
# ntp_manager falls back to a single server without this; esp_sntp_config_t sizes
# its server array from it.
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# Feeds link statistics to the status report.
CONFIG_LWIP_STATS=y
# `audio-net` sends a microphone over one TCP connection. lwIP's default window of four
# segments (5760 bytes) lets a sender move one window per round trip, which capped a stream
# at about 3.7 Mbit/s on a strong link: four microphones at 64 kHz fell 4% behind and at
# 75 kHz a quarter of the audio was dropped. At 32 kB the same streams ran at 100% with
# nothing dropped. It is a limit, not an allocation: memory is used only for data actually
# queued. Applies to every connection, which is the price of a shared default.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768

# --- Diagnostics -----------------------------------------------------------
# Keep the panic handler talking to the console rather than silently rebooting,
# so a crash on a bench is legible.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
