{
  "config_version": 1,
  "device_name": "esp-device",
  "instance_name": "Template Device",

  "wifi": {
    "hostname": "esp-device",
    "known_networks": [
      { "ssid": "your-network", "password": "your-passphrase", "priority": 10 }
    ],
    "ap_ssid": "esp-setup",
    "ap_password": "configure-me",
